generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Cliente {
  id          Int     @id @default(autoincrement())
  nome        String
  cpf         String  @unique
  telefone    String  @unique
  email       String  @unique
  senha       String

  pedidos Pedido[]

  criadoEm DateTime   @default(now())

  @@map("clientes")
}

model Pedido {
  id              Int     @id @default(autoincrement())
  cliente_id      Int    
  valor_final     Float   
  status          String  
  data_pedido     DateTime @default(now())
  data_entrega    DateTime?

  cliente Cliente @relation(fields: [cliente_id], references: [id])

  itens_pedidos ItemPedido[]

  @@map("pedidos")
}

model ItemPedido {
  id                  Int     @id @default(autoincrement())
  pedido_id           Int     
  estoque_opcao_id    Int     
  quantidade          Int
  preco_sub_total     Float 

  estoque_opcao EstoqueOpcao @relation(fields: [estoque_opcao_id], references: [id])
  pedido Pedido @relation(fields: [pedido_id], references: [id])

  @@map("itens pedidos")
}

model EstoqueOpcao {
  id                  Int     @id @default(autoincrement())
  produto_id          Int     
  cor                 String
  tamanho             String
  quantidade_estoque  Int @default(0)

  produto Produto @relation(fields: [produto_id], references: [id])

  item_pedido ItemPedido[]

  @@map("opções de estoque")
}

model Produto {
  id                Int     @id @default(autoincrement())
  categoria_id      Int     
  nome              String
  marca             String 
  preco_base        Float

  categoria Categoria @relation(fields: [categoria_id], references: [id])

  estoque_opcao EstoqueOpcao[]

  @@map("produtos")
}

model Categoria {
  id                Int     @id @default(autoincrement())
  nome              String  
  descricao         String

  produto Produto[]

  @@map("categorias")
}


model Funcionario {
  id      Int     @id @default(autoincrement())
  nome    String
  email   String  @unique
  senha   String
  cargo   String
}

